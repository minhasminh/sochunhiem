# ----------------------------------------------------------------------
# SO CHU NHIEM DIEN TU THCS - APACHE SPA CONFIGURATION (DIST ROOT)
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  DirectoryIndex index.html

  # Truong hop file hoac thu muc ton tai thuc te, phuc vu truc tiep
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Dinh tuyen tat ca cac route frontend con lai ve index.html de React xu ly (SPA Fallback)
  RewriteRule ^ index.html [L]
</IfModule>

# Cau hinh MIME Types chuan cho cac file static Vite
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Chặn truy cập trực tiếp file ẩn
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Bat nen Gzip/Brotli neu hosting co ho tro mod_deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
